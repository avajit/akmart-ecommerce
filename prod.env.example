# ==============================================================================
# Production Environment Variables Template (.env) — DO NOT COMMIT REAL SECRETS
# ==============================================================================

# Server
NODE_ENV=production
PORT=5000
BACKEND_URL=https://your-backend.onrender.com

# Database & Redis
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Auth Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN_MS=900000
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000
OTP_EXPIRES_IN_MS=900000
BCRYPT_SALT_ROUNDS=12
DEFAULT_USER_ROLE=CONSUMER

# Google SSO
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/google/callback

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="AKMart" <your_email@gmail.com>

# CORS Handshake (Vercel URL without trailing slash)
FRONTEND_WEB_URL=https://your-frontend.vercel.app
FRONTEND_MOBILE_URL=com.akmart.app

# Cloud Object Storage (Backblaze B2 / AWS S3)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your_b2_key_id
S3_SECRET_KEY=your_b2_app_key
S3_BUCKET=your-b2-bucket-name
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=300
MAX_IMAGE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
