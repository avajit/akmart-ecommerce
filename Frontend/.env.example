# ==============================================================================
# AkMart Frontend Environment Variables (.env.example)
# In local development: copy to .env
# In Vercel deployment: add these in Project Settings -> Environment Variables
# ==============================================================================

# Backend API Base URL (Render Web Service URL + /api/v1)
# Production Example: https://akmart-backend.onrender.com/api/v1
# Local Dev Example:  http://localhost:5000/api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1

# Google OAuth Client ID (must match Google Cloud Console authorized javascript origin)
# Example: 566091505588-m63tn9hbeni9s8f2mr3l8qgfgbgugk3o.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
