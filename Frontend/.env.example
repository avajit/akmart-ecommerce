# Frontend Environment Variables Template (.env.example)
# Copy this to .env in local development, or add in Vercel Project Settings

# Backend API Base URL (with trailing /api/v1)
# Development: http://localhost:5000/api/v1
# Production: https://akmart-backend.onrender.com/api/v1 (or your production API URL)
VITE_API_URL=http://localhost:5000/api/v1

# Google OAuth 2.0 Web Client ID
# From Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Sentry Error & Performance Monitoring (Optional)
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/1234567
