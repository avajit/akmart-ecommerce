// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String?  @unique
  phoneNumber      String?  @unique // Crucial for Nepal market (#26)
  passwordHash     String?
  googleId         String?  @unique
  fullName         String

  roleId           String
  role             Role     @relation(fields: [roleId], references: [id])

  isEmailVerified  Boolean  @default(false)
  isPhoneVerified  Boolean  @default(false)
  isActive         Boolean  @default(true)
  avatarUrl        String?

  deletedAt        DateTime? // Soft delete strategy (#4c)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]

  // Module 2 relations
  sellerProfile    SellerProfile?
  cart             Cart?
  wishlist         Wishlist?
  reviews          Review[]
  products         Product[]      @relation("ProductCreator")

  // Module 3 relations
  addresses        Address[]
  orders           Order[]

  // App-level rule (#13): enforce in service layer, not DB constraint —
  // every user must have at least one of passwordHash / googleId / phoneNumber+OTP

  @@index([email])
  @@index([phoneNumber])
}

// Fix #1: Separate Refresh Token table for multi-device support
model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// (VerificationToken table removed: OTPs are now securely stored in Redis)

// Fix #3: Audit logging for enterprise security (#3)
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String   // e.g. 'PRODUCT', 'ORDER', 'ROLE'
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())
}

// RBAC System
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // Fix #16: protects core roles from rename/delete

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g. 'CREATE_PRODUCT', 'DELETE_ANY_PRODUCT', 'VIEW_SALES'
  description String?

  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now()) // Fix #16b: audit trail for permission grants

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ============================================================
// MODULE 2: CORE COMMERCE
// ============================================================

// ── Category (hierarchical tree) ────────────────────────────
model Category {
  id               String                    @id @default(uuid())
  name             String
  slug             String                    @unique
  description      String?
  imageUrl         String?
  parentId         String?
  parent           Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]                @relation("CategoryTree")
  attributeConfigs CategoryAttributeConfig[]
  products         Product[]
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([parentId])
  @@index([slug])
}

// Defines which JSON keys are filterable per category
model CategoryAttributeConfig {
  id         String     @id @default(uuid())
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  key        String     // JSON key: "ram", "color", "size"
  label      String     // Display label: "RAM", "Color", "Size"
  filterType FilterType @default(MULTISELECT)
  unit       String?    // "GB", "mAh", "inches"
  order      Int        @default(0)

  @@unique([categoryId, key])
  @@index([categoryId])
}

enum FilterType {
  MULTISELECT
  RANGE
  BOOLEAN
}

// ── Brand ────────────────────────────────────────────────────
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([slug])
}

// ── SellerProfile (minimal onboarding → payout verification) ─
model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])

  // Required BEFORE first listing
  shopName           String
  shopDescription    String?
  shopLogoUrl        String?
  phoneNumber        String
  address            String
  city               String
  state              String
  pincode            String
  country            String             @default("NP")

  // Required BEFORE first payout (not before listing)
  gstNumber          String?
  panNumber          String?
  bankAccountNumber  String?
  bankIfscCode       String?
  bankAccountName    String?

  verificationStatus SellerVerification @default(PENDING)
  isPayoutEnabled    Boolean            @default(false)

  listings           SellerListing[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum SellerVerification {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ── Product (shared catalog — requires admin approval) ────────
model Product {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique // auto-generated: slugify(name) + nanoid(6)
  description     String
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]
  status          ProductStatus    @default(DRAFT)
  rejectionReason String?
  createdById     String
  createdBy       User             @relation("ProductCreator", fields: [createdById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([slug])
  @@index([createdById])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// ── ProductVariant (SKU level) ────────────────────────────────
model ProductVariant {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  name          String          // "Black / 256GB / 8GB RAM"
  sku           String          @unique
  attributes    Json            @default("{}") // JSONB: { "color": "Black", "ram": "8" }
  images        ProductImage[]
  listings      SellerListing[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
}

// ── ProductImage ──────────────────────────────────────────────
model ProductImage {
  id        String          @id @default(uuid())
  productId String?
  product   Product?        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  url       String          // placeholder URL for now; S3 wired later
  altText   String?
  isPrimary Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

// ── SellerListing (the actual offer: seller + variant + price + stock) ─
model SellerListing {
  id              String         @id @default(uuid())
  sellerProfileId String
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  price           Decimal        @db.Decimal(10, 2)
  mrp             Decimal        @db.Decimal(10, 2)
  // reservedStock touched ONLY at checkout (Module 3), NOT at add-to-cart
  stock           Int            @default(0)
  reservedStock   Int            @default(0)
  isActive        Boolean        @default(true)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sellerProfileId, variantId])
  @@index([variantId])
  @@index([sellerProfileId])
  @@index([isActive])
}

// ── Cart ──────────────────────────────────────────────────────
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id              String        @id @default(uuid())
  cartId          String
  cart            Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  sellerListingId String
  sellerListing   SellerListing @relation(fields: [sellerListingId], references: [id])
  quantity        Int           @default(1)
  priceAtAddTime  Decimal       @db.Decimal(10, 2) // price snapshot — immune to seller changes
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([cartId, sellerListingId])
  @@index([cartId])
  @@index([sellerListingId])
}

// ── Wishlist ──────────────────────────────────────────────────
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String         @id @default(uuid())
  wishlistId String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([wishlistId, variantId])
  @@index([wishlistId])
}

// ── Review ────────────────────────────────────────────────────
model Review {
  id                 String    @id @default(uuid())
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  rating             Int       // 1–5 (validated in service layer)
  title              String?
  body               String?
  isVerifiedPurchase Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// MODULE 3: ORDERS & CHECKOUT
// ============================================================

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zipCode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([userId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingAddressId String
  shippingAddress Address     @relation(fields: [shippingAddressId], references: [id])
  status          OrderStatus @default(PENDING) // PENDING means pending confirmation/payment
  paymentMethod   String      @default("COD")   // "COD" only for now
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerListingId String
  sellerListing   SellerListing  @relation(fields: [sellerListingId], references: [id])
  sellerId        String         // To easily query orders by seller without deep joins
  quantity        Int
  priceAtPurchase Decimal        @db.Decimal(10, 2) // Snapshotted price
  status          FulfillmentStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([sellerListingId])
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

