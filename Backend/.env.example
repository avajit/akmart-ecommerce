# ==============================================================================
# AkMart Backend Environment Variables Template (.env.example)
# Copy this file to .env in local development, or add these keys in Render Dashboard
# ==============================================================================

# 1. SERVER & RUNTIME
NODE_ENV=production
PORT=5000
# Production backend public URL (e.g. https://akmart-backend.onrender.com)
BACKEND_URL=https://your-backend.onrender.com

# 2. DATABASE (PostgreSQL)
# Supports: Render PostgreSQL, Supabase, Neon, AWS RDS, Docker
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://akmart_user:your_secure_password@your-postgres-host:5432/akmart_db?sslmode=require

# 3. REDIS (Caching, Session, and Rate Limiting)
# Supports: Render Redis, Upstash Redis, Redis Cloud
# Format: redis://default:password@host:port or rediss:// for SSL
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379

# 4. AUTHENTICATION & SECURITY
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN_MS=900000
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000
OTP_EXPIRES_IN_MS=900000
BCRYPT_SALT_ROUNDS=12
DEFAULT_USER_ROLE=CONSUMER

# 5. GOOGLE SSO (OAUTH 2.0)
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/google/callback

# 6. EMAIL & OTP (SMTP)
# Options: Gmail App Password, Resend SMTP, SendGrid, Ethereal (Dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_FROM="AKMart" <your_email@gmail.com>

# 7. FRONTEND URLS (CRITICAL FOR CORS & COOKIE SECURITY)
# Must match your Vercel deployment URL without trailing slash
FRONTEND_WEB_URL=https://your-akmart-app.vercel.app
FRONTEND_MOBILE_URL=com.akmart.app

# 8. S3-COMPATIBLE OBJECT STORAGE (Backblaze B2 / AWS S3 / Cloudflare R2)
# Backblaze B2 settings:
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your_b2_application_key_id
S3_SECRET_KEY=your_b2_application_key
S3_BUCKET=your-b2-bucket-name
# Set to false for Backblaze B2 and AWS S3; true only for local MinIO
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=300
MAX_IMAGE_SIZE_MB=5

# 9. RATE LIMITING (Sliding window via Redis)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# 10. PAYMENT GATEWAYS (Optional / Sandbox for Nepal)
ESEWA_MERCHANT_ID=epay_payment
KHALTI_PUBLIC_KEY=test_public_key_...
KHALTI_SECRET_KEY=test_secret_key_...
