# Environment configuration for AkMart Backend

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://akmart_user:akmart_password@localhost:5432/akmart_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET="super_secret_access_key_change_me_in_prod"
JWT_REFRESH_SECRET="super_secret_refresh_key_change_me_in_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google SSO (OAuth2)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Frontend URLs (For CORS)
FRONTEND_WEB_URL="http://localhost:5173"
FRONTEND_MOBILE_URL="com.akmart.app" # Scheme or domain for React Native

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AWS S3 (Images)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="akmart-media"

# Payments (eSewa / Khalti - Sandbox keys for local dev)
ESEWA_MERCHANT_ID="epay_payment"
KHALTI_PUBLIC_KEY="test_public_key_..."
KHALTI_SECRET_KEY="test_secret_key_..."
